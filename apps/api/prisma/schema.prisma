generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REQUESTER
  DEPARTMENT_HEAD
  PROCUREMENT_MANAGER
  FINANCE_HEAD
  MANAGING_DIRECTOR
  PROCUREMENT_OFFICER
  ACCOUNTS_PAYABLE
  WAREHOUSE_USER
  INTERNAL_AUDITOR
  SYSTEM_ADMIN
  VENDOR_USER
}

enum PRStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum POStatus {
  DRAFT
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  role          Role      @default(REQUESTER)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  purchaseRequisitions PurchaseRequisition[]
  approvals            ApprovalRequest[]
  auditLogs            AuditLog[]
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  purchaseRequisitions PurchaseRequisition[]
}

model Vendor {
  id             String   @id @default(uuid())
  vendorCode     String   @unique // VND-XXXXX
  name           String
  category       String
  email          String?
  phone          String?
  address        String?
  taxId          String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseRequisition {
  id              String    @id @default(uuid())
  prNumber        String    @unique // PR-YYYY-XXXXX
  description     String
  status          PRStatus  @default(DRAFT)
  priority        Priority  @default(MEDIUM)
  totalAmount     Decimal   @db.Decimal(18, 2)
  requesterId     String
  requester       User      @relation(fields: [requesterId], references: [id])
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items           PurchaseRequisitionItem[]
  approvalRequests ApprovalRequest[]
  purchaseOrders   PurchaseOrder[]
}

model PurchaseRequisitionItem {
  id                    String              @id @default(uuid())
  description           String
  quantity              Decimal             @db.Decimal(18, 2)
  unitPrice             Decimal             @db.Decimal(18, 2)
  totalPrice            Decimal             @db.Decimal(18, 2)
  purchaseRequisitionId String
  purchaseRequisition   PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id])
}

model ApprovalRequest {
  id                    String         @id @default(uuid())
  step                  Int
  status                ApprovalStatus @default(PENDING)
  approverId            String
  approver              User           @relation(fields: [approverId], references: [id])
  purchaseRequisitionId String
  purchaseRequisition   PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id])
  comments              String?
  approvedAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model PurchaseOrder {
  id                    String              @id @default(uuid())
  poNumber              String              @unique // PO-YYYY-XXXXX
  status                POStatus            @default(DRAFT)
  totalAmount           Decimal             @db.Decimal(18, 2)
  vendorId              String
  vendor                Vendor              @relation(fields: [vendorId], references: [id])
  purchaseRequisitionId String
  purchaseRequisition   PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  description     String
  quantity        Decimal       @db.Decimal(18, 2)
  unitPrice       Decimal       @db.Decimal(18, 2)
  totalPrice      Decimal       @db.Decimal(18, 2)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  action      String
  oldValue    Json?
  newValue    Json?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model RulesConfig {
  id          String   @id @default(uuid())
  category    String   // ROUTING, VALIDATION, ESCALATION, etc.
  name        String
  rule        Json     // Condition and Action
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
